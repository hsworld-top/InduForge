{
  "name": "induforge",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vue/eslint-config-prettier": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vue-eslint-parser": "^10.0.0"
  },
  "scripts": {
    "dev:core": "cd dev_core && go run ./cmd/dev_core",
    "dev:ide": "pnpm --filter ide dev",
    "dev:datacenter": "pnpm --filter datacenter dev",
    "dev:designer": "pnpm --filter designer dev",
    "dev:agent-front": "pnpm --filter node_agent_front dev",
    "build:ide": "pnpm --filter ide build",
    "build:datacenter": "pnpm --filter datacenter build",
    "build:designer": "pnpm --filter designer build",
    "build:agent-front": "pnpm --filter node_agent_front build",
    "test:core": "pnpm go:test:core",
    "test:datacenter": "pnpm --filter datacenter test",
    "test:designer": "pnpm --filter designer test",
    "lint:ide": "pnpm --filter ide lint",
    "lint:datacenter": "pnpm --filter datacenter lint",
    "lint:designer": "pnpm --filter designer lint",
    "lint:agent-front": "pnpm --filter node_agent_front lint",
    "lint:js": "pnpm lint:ide && pnpm lint:datacenter && pnpm lint:designer && pnpm lint:agent-front",
    "go:vet:core": "cd dev_core && go vet ./...",
    "go:vet:data": "cd data_service && go vet ./...",
    "go:vet:agent": "cd runtime/node_agent && go vet ./...",
    "go:vet": "pnpm go:vet:core && pnpm go:vet:data && pnpm go:vet:agent",
    "lint": "pnpm lint:js && pnpm go:vet",
    "format:ide": "pnpm --filter ide format",
    "format:datacenter": "pnpm --filter datacenter format",
    "format:designer": "pnpm --filter designer format",
    "format:agent-front": "pnpm --filter node_agent_front format",
    "format:js": "pnpm format:ide && pnpm format:datacenter && pnpm format:designer && pnpm format:agent-front",
    "format:docs": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern \"*.md\" \"docs/**/*.md\" \"scripts/**/*.md\" \"*.json\" \"docs/**/*.yml\" \"docs/**/*.yaml\" \"scripts/**/*.yml\" \"scripts/**/*.yaml\"",
    "go:fmt": "gofmt -w dev_core data_service runtime/node_agent",
    "go:test:core": "cd dev_core && go test ./...",
    "go:test:data": "cd data_service && go test ./...",
    "go:test:agent": "cd runtime/node_agent && go test ./...",
    "go:test": "pnpm go:test:core && pnpm go:test:data && pnpm go:test:agent",
    "format": "pnpm format:js && pnpm format:docs && pnpm go:fmt",
    "typecheck:ide": "pnpm --filter ide typecheck",
    "typecheck:datacenter": "pnpm --filter datacenter typecheck",
    "typecheck:designer": "pnpm --filter designer typecheck",
    "typecheck": "pnpm typecheck:ide && pnpm typecheck:datacenter && pnpm typecheck:designer",
    "dotnet:restore:collector": "dotnet restore collector/InduForge.Collector.slnx",
    "dotnet:build:collector": "dotnet build collector/InduForge.Collector.slnx --no-restore",
    "dotnet:test:collector": "dotnet test collector/InduForge.Collector.slnx",
    "dotnet:publish:collector-dev": "dotnet publish collector/src/InduForge.Collector.DevAgent/InduForge.Collector.DevAgent.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o collector/artifacts/win-x64"
  }
}
