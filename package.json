{
  "name": "induforge",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vue/eslint-config-prettier": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^15.15.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vue-eslint-parser": "^10.0.0"
  },
  "scripts": {
    "dev:env": "node scripts/dev/ensure-development-env.mjs",
    "dev:core": "pnpm dev:env && cd dev_core && air",
    "dev:data": "pnpm dev:env && cd data_service && air",
    "dev:ide": "pnpm dev:env && pnpm --filter ide dev",
    "dev:datacenter": "pnpm dev:env && pnpm --filter datacenter dev",
    "dev:designer": "pnpm dev:env && pnpm --filter designer dev",
    "dev:node-agent-front": "pnpm dev:env && pnpm --filter node_agent_front dev",
    "build:core": "cd dev_core && go build ./...",
    "build:data": "cd data_service && go build ./...",
    "build:node-agent": "cd runtime/node_agent && go build ./...",
    "build:ide": "pnpm --filter ide build",
    "build:datacenter": "pnpm --filter datacenter build",
    "build:designer": "pnpm --filter designer build",
    "build:node-agent-front": "pnpm --filter node_agent_front build",
    "build:go": "pnpm build:core && pnpm build:data && pnpm build:node-agent",
    "build:frontend": "pnpm build:ide && pnpm build:datacenter && pnpm build:designer && pnpm build:node-agent-front",
    "build": "pnpm build:frontend && pnpm build:go",
    "test:core": "cd dev_core && go test ./...",
    "test:data": "cd data_service && go test ./...",
    "test:node-agent": "cd runtime/node_agent && go test ./...",
    "test:ide": "pnpm --filter ide test",
    "test:datacenter": "pnpm --filter datacenter test",
    "test:designer": "pnpm --filter designer test",
    "test:go": "pnpm test:core && pnpm test:data && pnpm test:node-agent",
    "test:frontend": "pnpm test:ide && pnpm test:datacenter && pnpm test:designer",
    "test": "pnpm test:frontend && pnpm test:go",
    "lint:core": "cd dev_core && go vet ./...",
    "lint:data": "cd data_service && go vet ./...",
    "lint:node-agent": "cd runtime/node_agent && go vet ./...",
    "lint:ide": "pnpm --filter ide lint",
    "lint:datacenter": "pnpm --filter datacenter lint",
    "lint:designer": "pnpm --filter designer lint",
    "lint:node-agent-front": "pnpm --filter node_agent_front lint",
    "lint:go": "pnpm lint:core && pnpm lint:data && pnpm lint:node-agent",
    "lint:frontend": "pnpm lint:ide && pnpm lint:datacenter && pnpm lint:designer && pnpm lint:node-agent-front",
    "lint": "pnpm lint:frontend && pnpm lint:go",
    "lint:fix:ide": "pnpm --filter ide lint:fix",
    "lint:fix:datacenter": "pnpm --filter datacenter lint:fix",
    "lint:fix:designer": "pnpm --filter designer lint:fix",
    "lint:fix:node-agent-front": "pnpm --filter node_agent_front lint:fix",
    "lint:fix:frontend": "pnpm lint:fix:ide && pnpm lint:fix:datacenter && pnpm lint:fix:designer && pnpm lint:fix:node-agent-front",
    "format:ide": "pnpm --filter ide format",
    "format:datacenter": "pnpm --filter datacenter format",
    "format:designer": "pnpm --filter designer format",
    "format:node-agent-front": "pnpm --filter node_agent_front format",
    "format:frontend": "pnpm format:ide && pnpm format:datacenter && pnpm format:designer && pnpm format:node-agent-front",
    "format:docs": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern \"*.md\" \"docs/**/*.md\" \"scripts/**/*.md\" \"*.json\" \"docs/**/*.yml\" \"docs/**/*.yaml\" \"scripts/**/*.yml\" \"scripts/**/*.yaml\"",
    "format:go": "node scripts/dev/check-gofmt.mjs --write",
    "format": "pnpm format:frontend && pnpm format:docs && pnpm format:go",
    "format:check:ide": "pnpm --filter ide format:check",
    "format:check:datacenter": "pnpm --filter datacenter format:check",
    "format:check:designer": "pnpm --filter designer format:check",
    "format:check:node-agent-front": "pnpm --filter node_agent_front format:check",
    "format:check:frontend": "pnpm format:check:ide && pnpm format:check:datacenter && pnpm format:check:designer && pnpm format:check:node-agent-front",
    "format:check:docs": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern \"*.md\" \"docs/**/*.md\" \"scripts/**/*.md\" \"*.json\" \"docs/**/*.yml\" \"docs/**/*.yaml\" \"scripts/**/*.yml\" \"scripts/**/*.yaml\"",
    "format:check:go": "node scripts/dev/check-gofmt.mjs",
    "format:check": "pnpm format:check:frontend && pnpm format:check:docs && pnpm format:check:go",
    "fix": "pnpm lint:fix:frontend && pnpm format",
    "typecheck:ide": "pnpm --filter ide typecheck",
    "typecheck:datacenter": "pnpm --filter datacenter typecheck",
    "typecheck:designer": "pnpm --filter designer typecheck",
    "typecheck:frontend": "pnpm typecheck:ide && pnpm typecheck:datacenter && pnpm typecheck:designer",
    "typecheck": "pnpm typecheck:frontend",
    "collector:restore": "dotnet restore collector/InduForge.Collector.slnx",
    "collector:build": "dotnet build collector/InduForge.Collector.slnx --no-restore",
    "collector:test": "dotnet test collector/InduForge.Collector.slnx",
    "collector:publish:dev": "dotnet publish collector/src/InduForge.Collector.DevAgent/InduForge.Collector.DevAgent.csproj -c Release -r win-x64 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -o collector/artifacts/win-x64"
  }
}
