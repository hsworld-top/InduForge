# Mac 只运行前端，所有浏览器请求仍留在当前 Vite origin，由 Vite 转发到中心入口。
# 复制为 .env.frontend-linux 后按实际环境修改；此变量不会注入浏览器代码。
IF_FRONTEND_PROXY_TARGET=http://your-center-host:18080
# 仅 frontend-linux 使用：后端返回工作区 URL 的受控远端域名后缀（不含协议和端口）。
# 例如远端 URL 为 http://ai-<uuid>.workspace.172.16.125.129.nip.io:18080/ 时填写下列值。
IF_FRONTEND_WORKSPACE_PROXY_SUFFIX=workspace.172.16.125.129.nip.io
# 独立工作区代理端口；默认 18604。它只接收四类受控 workspace Host，不承载 IDE 页面。
IF_FRONTEND_WORKSPACE_PROXY_PORT=18604
