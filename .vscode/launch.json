{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Go NodeAgent",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/runtime/node_agent/cmd",
      "cwd": "${workspaceFolder}/runtime/node_agent",
      "console": "integratedTerminal",
      "env": {
        "NODE_AGENT_ENV": "development",
        "NODE_AGENT_CONFIG": "${workspaceFolder}/runtime/node_agent/cmd/config.yaml"
      }
    },
    {
      "name": "调试 Go 控制面 (Dev Core)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/dev_core/cmd/dev_core",
      "cwd": "${workspaceFolder}/dev_core",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "启动 IDE 前端 (pnpm dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/dev_ide"
    },
    {
      "name": "启动数据中心前端 (pnpm dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/datacenter"
    },
    {
      "name": "启动设计中心前端 (pnpm dev)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/designer"
    }
  ],
  "compounds": []
}
