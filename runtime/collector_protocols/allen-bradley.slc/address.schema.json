{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["address"],"properties":{"address":{"type":"string","title":"PLC 文件地址（address）","description":"例如 A9:0、B9:0、N9:0、S:0/1、ST1:0","pattern":"^(?:(?:s|dst|src)=\\d+;)*(?:ST|A|B|N|F|S|C|I|O|R|T|L)\\d*:\\d+(?:(?:/|\\.)\\d+)?$","maxLength":512,"x-induforge-address-text":true}}}
