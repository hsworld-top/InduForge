{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "port"],
  "properties": {
    "host": {
      "type": "string",
      "title": "设备 IP / 主机名（host）",
      "description": "请输入 Modbus TCP 设备的 IPv4、IPv6 或主机名",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "title": "端口（port）",
      "description": "Modbus TCP 服务端口",
      "minimum": 1,
      "maximum": 65535,
      "default": 502
    },
    "connectTimeoutMs": {
      "type": "integer",
      "title": "连接超时（connectTimeoutMs）",
      "description": "建立 TCP 连接的最大等待时间",
      "minimum": 100,
      "maximum": 120000,
      "default": 5000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    },
    "dataFormat": {
      "type": "string",
      "title": "多寄存器数据格式（dataFormat）",
      "description": "控制 32 位及以上数值在多个寄存器中的字节顺序",
      "enum": ["ABCD", "BADC", "CDAB", "DCBA"],
      "default": "ABCD",
      "x-induforge-enum-labels": {
        "ABCD": "大端顺序（ABCD）",
        "BADC": "字节交换（BADC）",
        "CDAB": "字交换（CDAB）",
        "DCBA": "完全反转（DCBA）"
      },
      "x-induforge-advanced": true
    }
  }
}
