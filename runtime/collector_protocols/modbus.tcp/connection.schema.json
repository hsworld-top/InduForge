{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "port"],
  "properties": {
    "host": { "type": "string", "minLength": 1 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 502 },
    "connectTimeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000,
      "default": 5000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    }
  }
}
