{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["station", "area", "address"],
  "properties": {
    "station": { "type": "integer", "minimum": 0, "maximum": 255 },
    "area": {
      "type": "string",
      "enum": ["coil", "discreteInput", "inputRegister", "holdingRegister"]
    },
    "address": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "x-induforge-address-text": true
    },
    "bitIndex": { "type": "integer", "minimum": 0, "maximum": 15 }
  }
}
