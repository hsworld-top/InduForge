{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["portName","baudRate","dataBits","parity","stopBits","station","instrumentType","enableCodeFE"],"properties":{"portName":{"type":"string","title":"串口名称（portName）","description":"Windows 示例：COM3","minLength":1},"baudRate":{"type":"integer","title":"波特率（baudRate）","enum":[1200,2400,4800,9600,19200,38400,57600,115200],"default":9600},"dataBits":{"type":"integer","title":"数据位（dataBits）","enum":[7,8],"default":8},"parity":{"type":"string","title":"校验方式（parity）","enum":["none","odd","even"],"default":"none","x-induforge-enum-labels":{"none":"无校验（none）","odd":"奇校验（odd）","even":"偶校验（even）"}},"stopBits":{"type":"integer","title":"停止位（stopBits）","enum":[1,2],"default":1},"station":{"type":"string","title":"表地址（station）","description":"最多 14 位 BCD 地址，可使用 A 作为高位通配符","pattern":"^[0-9Aa]{1,14}$","default":"78330015040963"},"instrumentType":{"type":"string","title":"仪表类型（instrumentType）","description":"两位十六进制类型码，例如 19","pattern":"^[0-9A-Fa-f]{2}$","default":"19"},"enableCodeFE":{"type":"boolean","title":"启用 FE 前导码（enableCodeFE）","default":false},"stationMatch":{"type":"boolean","title":"校验响应表地址（stationMatch）","default":false,"x-induforge-advanced":true},"receiveTimeoutMs":{"type":"integer","title":"接收超时（receiveTimeoutMs）","minimum":100,"maximum":120000,"default":10000,"x-induforge-unit":"ms","x-induforge-advanced":true}}}
