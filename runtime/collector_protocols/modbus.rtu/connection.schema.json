{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["portName", "baudRate", "dataBits", "parity", "stopBits"],
  "properties": {
    "portName": { "type": "string", "minLength": 1 },
    "baudRate": {
      "type": "integer",
      "enum": [1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200]
    },
    "dataBits": { "type": "integer", "enum": [7, 8], "default": 8 },
    "parity": { "type": "string", "enum": ["none", "odd", "even"], "default": "none" },
    "stopBits": { "type": "string", "enum": ["one", "two"], "default": "one" },
    "timeoutMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 120000,
      "default": 3000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    }
  }
}
