# Claude Agent 忽略文件
# 由 scripts/ai-rules/sync-ignore-files.mjs 自动生成，请勿手改。
# 用于生态兼容；Claude Code 实际权限仍以 .claude/settings.json 为准。

# Node.js 依赖
node_modules/
**/node_modules/

# 构建产物
dist/
**/dist/
build/
**/build/
.nyc_output/
coverage/
**/coverage/

# 日志与缓存
*.log
*.pid
*.seed
.npm-cache/
runtime/logs/
runtime/node_agent/logs/
**/logs/

# 环境与密钥
.env
.env.*
!.env.example

# 版本控制与锁文件
.git/
.svn/
*.lock
pnpm-lock.yaml
package-lock.json
yarn.lock

# 其他大体积或低价值目录
docker/
docker/images/
minio/data*/
dev_core/artifacts/
