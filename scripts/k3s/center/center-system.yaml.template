---
apiVersion: v1
kind: Service
metadata:
  name: center-data
  namespace: induforge-system
spec:
  selector:
    app.kubernetes.io/name: center-data
  ports:
    - name: http
      port: 18102
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: center-data
  namespace: induforge-system
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: center-data
  template:
    metadata:
      labels:
        app.kubernetes.io/name: center-data
        app.kubernetes.io/part-of: induforge-center
    spec:
      nodeSelector:
        induforge.io/center-node: "true"
      initContainers:
        - name: wait-center-infrastructure
          image: docker.io/rancher/mirrored-library-busybox:1.37.0
          imagePullPolicy: Never
          command: ["/bin/sh", "-ec"]
          args:
            - |
              until nc -z center-meta-store 18432; do sleep 2; done
              until nc -z center-cache-store 18379; do sleep 2; done
        # IF 时序库固定使用 if_dev_data；在 data_service 启动和内置教程 seed 前完成空库与扩展准备。
        - name: initialize-dev-timeseries
          image: docker.io/timescale/timescaledb:2.26.4-pg16
          imagePullPolicy: Never
          command: ["/bin/sh", "-ec"]
          args:
            - |
              case "${IF_META_STORE_DEV_DATA_DB}" in
                ''|*[!A-Za-z0-9_]* ) echo "invalid IF_META_STORE_DEV_DATA_DB" >&2; exit 1 ;;
              esac
              export PGPASSWORD="${IF_META_STORE_PASSWORD}"
              if ! psql -h center-meta-store -p 18432 -U "${IF_META_STORE_USER}" -d "${IF_META_STORE_ADMIN_DATABASE}" -tAc "SELECT 1 FROM pg_database WHERE datname='${IF_META_STORE_DEV_DATA_DB}'" | grep -qx 1; then
                psql -h center-meta-store -p 18432 -U "${IF_META_STORE_USER}" -d "${IF_META_STORE_ADMIN_DATABASE}" -c "CREATE DATABASE \"${IF_META_STORE_DEV_DATA_DB}\""
              fi
              psql -h center-meta-store -p 18432 -U "${IF_META_STORE_USER}" -d "${IF_META_STORE_DEV_DATA_DB}" -c 'CREATE EXTENSION IF NOT EXISTS timescaledb;'
          env:
            - name: IF_META_STORE_USER
              valueFrom:
                secretKeyRef:
                  name: center-env
                  key: IF_META_STORE_USER
            - name: IF_META_STORE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: center-env
                  key: IF_META_STORE_PASSWORD
            - name: IF_META_STORE_ADMIN_DATABASE
              valueFrom:
                secretKeyRef:
                  name: center-env
                  key: IF_META_STORE_ADMIN_DATABASE
            - name: IF_META_STORE_DEV_DATA_DB
              valueFrom:
                secretKeyRef:
                  name: center-env
                  key: IF_META_STORE_DEV_DATA_DB
      containers:
        - name: data
          image: __DATA_IMAGE__
          imagePullPolicy: Never
          envFrom:
            - secretRef:
                name: center-env
          env:
            - name: NODE_ENV
              value: production
            - name: DB_AUTO_SCHEMA_SYNC
              value: "false"
            - name: DATA_SERVICE_ADDR
              value: :18102
            - name: DATA_SERVICE_COMPUTE_SANDBOX_URL
              value: http://compute-sandbox:18103
            - name: DATA_SERVICE_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: center-env
                  key: DATA_SERVICE_INTERNAL_TOKEN
            - name: DATA_SERVICE_COLLECTOR_PROTOCOL_CATALOG_PATH
              value: /contracts/collector-protocols
            - name: IF_META_STORE_HOST
              value: center-meta-store
            - name: IF_META_STORE_PORT
              value: "18432"
            - name: IF_CACHE_STORE_HOST
              value: center-cache-store
            - name: IF_CACHE_STORE_PORT
              value: "18379"
          ports:
            - name: http
              containerPort: 18102
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 3
            periodSeconds: 3
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 768Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
---
apiVersion: v1
kind: Service
metadata:
  name: center-control
  namespace: induforge-system
spec:
  selector:
    app.kubernetes.io/name: center-control
  ports:
    - name: http
      port: 18101
      targetPort: http
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: center-control
  namespace: induforge-system
spec:
  replicas: 1
  strategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 0
      maxSurge: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: center-control
  template:
    metadata:
      labels:
        app.kubernetes.io/name: center-control
        app.kubernetes.io/part-of: induforge-center
    spec:
      serviceAccountName: center-control
      nodeSelector:
        induforge.io/center-node: "true"
      securityContext:
        supplementalGroups: [__DOCKER_GID__]
        fsGroup: 1000
      initContainers:
        - name: wait-center-infrastructure
          image: docker.io/rancher/mirrored-library-busybox:1.37.0
          imagePullPolicy: Never
          command: ["/bin/sh", "-ec"]
          args:
            - |
              until nc -z center-meta-store 18432; do sleep 2; done
              until nc -z center-cache-store 18379; do sleep 2; done
              until nc -z center-object-store 18500; do sleep 2; done
              until nc -z center-data 18102; do sleep 2; done
      containers:
        - name: control
          image: __CONTROL_IMAGE__
          imagePullPolicy: Never
          envFrom:
            - secretRef:
                name: center-env
          env:
            - name: DEV_CORE_ADDR
              value: :18101
            - name: DB_AUTO_SCHEMA_SYNC
              value: "false"
            - name: IF_META_STORE_HOST
              value: center-meta-store
            - name: IF_META_STORE_PORT
              value: "18432"
            - name: IF_CACHE_STORE_HOST
              value: center-cache-store
            - name: IF_CACHE_STORE_PORT
              value: "18379"
            - name: IF_OBJECT_STORE_ENDPOINT
              value: center-object-store
            - name: IF_OBJECT_STORE_PORT
              value: "18500"
            - name: DATA_SERVICE_URL
              value: http://center-data:18102
            - name: DATA_SERVICE_INTERNAL_TOKEN
              valueFrom:
                secretKeyRef:
                  name: center-env
                  key: DATA_SERVICE_INTERNAL_TOKEN
            - name: CODE_WORKSPACE_ROOT
              value: /var/lib/induforge/workspaces
            # 控制 Pod 内路径与节点 hostPath 不同，K3s 子 Pod 必须使用节点真实目录。
            - name: CODE_WORKSPACE_HOST_PATH
              value: __DATA_ROOT__/workspaces
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            - name: CODE_SERVER_DOCKER_HOST
              value: unix:///var/run/docker.sock
            # K3s 工作区镜像由离线安装包导入 containerd；不能沿用本地 Docker 的开发标签。
            - name: CODE_SERVER_IMAGE
              value: induforge/designer-code-server:4.131.0-node22-pnpm10.19.0
            - name: CODE_WORKSPACE_ENGINE
              value: kubernetes
            - name: CODE_WORKSPACE_VOLUME
              value: __RELEASE_WORKSPACE_VOLUME__
            - name: RELEASE_BUILDER_ENABLED
              value: "true"
            - name: RELEASE_BUILDER_IMAGE
              value: __RELEASE_BUILDER_IMAGE__
            - name: RELEASE_BUILDER_ID
              value: __RELEASE_BUILDER_ID__
            - name: RELEASE_SIGNING_KEY_FILE
              value: /var/run/induforge/release-signing-key.pem
            - name: RELEASE_SIGNING_KEY_ID
              value: __RELEASE_KEY_ID__
            - name: RELEASE_MIN_NODE_AGENT_VERSION
              value: __RELEASE_MIN_AGENT_VERSION__
            - name: RELEASE_MIN_RUNTIME_VERSION
              value: __RELEASE_MIN_RUNTIME_VERSION__
          ports:
            - name: http
              containerPort: 18101
          readinessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 3
            periodSeconds: 3
          livenessProbe:
            httpGet:
              path: /health
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              memory: 768Mi
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          volumeMounts:
            - name: workspaces
              mountPath: /var/lib/induforge/workspaces
            # 兼容当前 Docker 代码工作区，待工作区调度切换到 K3s 后删除。
            - name: docker-socket
              mountPath: /var/run/docker.sock
            - name: ca-certificates
              mountPath: /etc/ssl/certs/ca-certificates.crt
              readOnly: true
            - name: temp
              mountPath: /tmp
            - name: release-signing-key
              mountPath: /var/run/induforge/release-signing-key.pem
              subPath: release-signing-key.pem
              readOnly: true
      volumes:
        - name: workspaces
          hostPath:
            path: __DATA_ROOT__/workspaces
            type: Directory
        - name: docker-socket
          hostPath:
            path: /var/run/docker.sock
            type: Socket
        - name: ca-certificates
          hostPath:
            path: /etc/ssl/certs/ca-certificates.crt
            type: File
        - name: temp
          emptyDir: {}
        - name: release-signing-key
          secret:
            secretName: release-signing-key
            defaultMode: 0400
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: center-edge
  namespace: induforge-system
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: center-edge
  template:
    metadata:
      labels:
        app.kubernetes.io/name: center-edge
        app.kubernetes.io/part-of: induforge-center
    spec:
      nodeSelector:
        induforge.io/center-node: "true"
      terminationGracePeriodSeconds: 5
      initContainers:
        - name: wait-center-control
          image: docker.io/rancher/mirrored-library-busybox:1.37.0
          imagePullPolicy: Never
          command: ["/bin/sh", "-ec"]
          args:
            - until nc -z center-control 18101; do sleep 2; done
      containers:
        - name: nginx
          image: __EDGE_IMAGE__
          imagePullPolicy: Never
          ports:
            - name: http
              containerPort: 80
              hostPort: __HTTP_PORT__
            - name: https
              containerPort: 443
              hostPort: __HTTPS_PORT__
          readinessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 2
            periodSeconds: 3
          livenessProbe:
            httpGet:
              path: /
              port: http
            initialDelaySeconds: 10
            periodSeconds: 10
          resources:
            requests:
              cpu: 25m
              memory: 32Mi
            limits:
              memory: 256Mi
          volumeMounts:
            - name: config
              mountPath: /etc/nginx/nginx.conf
              subPath: nginx.conf
              readOnly: true
            - name: tls
              mountPath: /etc/nginx/tls
              readOnly: true
      volumes:
        - name: config
          configMap:
            name: center-edge-config
        - name: tls
          hostPath:
            path: __DATA_ROOT__/tls
            type: Directory
