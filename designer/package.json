{
  "name": "designer",
  "type": "module",
  "version": "1.0.0",
  "description": "设计中心前端",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm exec vite build",
    "typecheck": "pnpm exec vue-tsc --noEmit",
    "preview": "vite preview",
    "lint:check": "pnpm exec eslint src scripts env.d.ts eslint.config.mjs vitest.config.js vite.config.js postcss.config.js tailwind.config.js --max-warnings 99999",
    "lint": "pnpm exec eslint src scripts env.d.ts eslint.config.mjs vitest.config.js vite.config.js postcss.config.js tailwind.config.js --max-warnings 99999 --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue,css}\" \"scripts/**/*.mjs\" \"*.{json,mjs,js,ts}\"",
    "test": "pnpm exec vitest --run",
    "test:watch": "pnpm exec vitest"
  },
  "dependencies": {
    "@vueuse/core": "^14.1.0",
    "axios": "^1.13.2",
    "dayjs": "^1.11.13",
    "echarts": "^6.0.0",
    "element-plus": "^2.11.7",
    "gsap": "^3.13.0",
    "konva": "^10.0.12",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "prettier": "^3.6.2",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.24",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.3.2",
    "vue-konva": "^3.2.6",
    "vue-router": "^4.6.3",
    "vue3-grid-layout": "^1.0.0",
    "vue3-sketch-ruler": "^2.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@iconify/json": "^2.2.168",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.5.1",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "unplugin-icons": "^0.19.0",
    "vite": "^7.2.2",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.2.6"
  }
}
