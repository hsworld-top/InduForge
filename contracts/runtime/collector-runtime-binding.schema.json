{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://induforge.dev/contracts/runtime/collector-runtime-binding.schema.json",
  "title": "collector-runtime-binding.v1",
  "$comment": "Binding 仅绑定 deployment 的现场资源与 Secret 引用；Secret 值、下载 URL 和 NATS 凭据不得序列化到本对象。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bindingId",
    "bindingRevision",
    "deploymentId",
    "accountId",
    "artifact",
    "collectorId",
    "ownership",
    "connections",
    "nats",
    "walCapacity"
  ],
  "properties": {
    "schemaVersion": {
      "const": "collector-runtime-binding.v1"
    },
    "bindingId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "bindingRevision": {
      "type": "integer",
      "minimum": 1
    },
    "deploymentId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "accountId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "artifact": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "collectorId": {
      "$ref": "common.schema.json#/$defs/stableId"
    },
    "ownership": {
      "$ref": "common.schema.json#/$defs/ownership"
    },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "connectionId",
          "resourceRef"
        ],
        "properties": {
          "connectionId": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "resourceRef": {
            "type": "string",
            "pattern": "^site-resource://[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
          },
          "secretRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^secret://[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
            }
          }
        }
      },
      "uniqueItems": true
    },
    "nats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serverResourceRef",
        "credentialSecretRef",
        "rawSubjectPrefix"
      ],
      "properties": {
        "serverResourceRef": {
          "type": "string",
          "pattern": "^site-resource://[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
        },
        "credentialSecretRef": {
          "type": "string",
          "pattern": "^secret://[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}$"
        },
        "rawSubjectPrefix": {
          "const": "data.raw"
        }
      }
    },
    "walCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxBytes",
        "highWatermarkBytes",
        "diagnosticReserveBytes",
        "dataGapPolicy"
      ],
      "properties": {
        "maxBytes": {
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1073741824
        },
        "highWatermarkBytes": {
          "type": "integer",
          "minimum": 1
        },
        "diagnosticReserveBytes": {
          "type": "integer",
          "minimum": 1
        },
        "dataGapPolicy": {
          "const": "emit-alarm-event"
        }
      }
    }
  }
}
