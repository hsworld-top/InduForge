{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://induforge.dev/contracts/runtime/collector-runtime-artifact.schema.json",
  "title": "collector-runtime-artifact.v1",
  "$comment": "Artifact 是环境无关、不可变的逻辑采集模型；允许点位协议逻辑地址，禁止现场 endpoint、host、port、账号、密码、Token、NATS 凭据或任何 Secret 值。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "artifactId", "artifactRevision", "projectId", "collectorVersion", "connections", "pointMappings", "wal"],
  "properties": {
    "schemaVersion": { "const": "collector-runtime-artifact.v1" },
    "artifactId": { "$ref": "common.schema.json#/$defs/stableId" },
    "artifactRevision": { "type": "integer", "minimum": 1 },
    "projectId": { "$ref": "common.schema.json#/$defs/uuid" },
    "collectorVersion": { "type": "string", "minLength": 1 },
    "connections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectionId", "protocolFamily", "driverId", "driverVersion", "schemaVersion", "enabled", "requiredOperations", "defaultAcquisition"],
        "properties": {
          "connectionId": { "$ref": "common.schema.json#/$defs/uuid" },
          "protocolFamily": { "$ref": "common.schema.json#/$defs/stableId" },
          "driverId": { "$ref": "common.schema.json#/$defs/stableId" },
          "driverVersion": { "type": "string", "minLength": 1 },
          "schemaVersion": { "type": "integer", "minimum": 1 },
          "enabled": { "type": "boolean" },
          "requiredOperations": { "type": "array", "minItems": 1, "uniqueItems": true, "contains": { "const": "point.read" }, "items": { "type": "string", "minLength": 1 } },
          "defaultAcquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intervalMs", "deadband", "changeOnly"],
            "properties": {
              "intervalMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
              "deadband": { "type": "number", "minimum": 0 },
              "changeOnly": { "type": "boolean" }
            }
          }
        }
      },
      "uniqueItems": true
    },
    "pointMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["datapointId", "connectionId", "variableId", "dataType", "elementCount", "addressSchemaVersion", "address", "readOptions", "acquisitionMode", "effectiveAcquisition", "enabled"],
        "properties": {
          "datapointId": { "$ref": "common.schema.json#/$defs/uuid" },
          "connectionId": { "$ref": "common.schema.json#/$defs/uuid" },
          "variableId": { "$ref": "common.schema.json#/$defs/uuid" },
          "dataType": { "type": "string", "enum": ["bool", "int8", "uint8", "int16", "uint16", "int32", "uint32", "int64", "uint64", "float32", "float64", "decimal", "string", "bytes", "datetime"] },
          "elementCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
          "addressSchemaVersion": { "type": "integer", "minimum": 1 },
          "address": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" } },
          "readOptions": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/jsonValue" } },
          "acquisitionMode": { "type": "string", "enum": ["inherit", "override"] },
          "acquisitionOverrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "intervalMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
              "deadband": { "type": "number", "minimum": 0 },
              "changeOnly": { "type": "boolean" }
            }
          },
          "effectiveAcquisition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["intervalMs", "deadband", "changeOnly"],
            "properties": {
              "intervalMs": { "type": "integer", "minimum": 1, "maximum": 86400000 },
              "deadband": { "type": "number", "minimum": 0 },
              "changeOnly": { "type": "boolean" }
            }
          },
          "enabled": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": { "properties": { "acquisitionMode": { "const": "inherit" } } },
            "then": { "not": { "properties": { "acquisitionOverrides": {} }, "required": ["acquisitionOverrides"] } }
          },
          {
            "if": { "properties": { "acquisitionMode": { "const": "override" } } },
            "then": { "required": ["acquisitionOverrides"], "properties": { "acquisitionOverrides": { "type": "object", "minProperties": 1 } } }
          },
          {
            "if": { "properties": { "dataType": { "const": "bytes" } } },
            "then": { "properties": { "elementCount": { "const": 1 } } }
          }
        ]
      },
      "uniqueItems": true
    },
    "wal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fsync", "checksum", "commitMarker"],
      "properties": {
        "fsync": { "const": "before-publish" },
        "checksum": { "const": "crc32c" },
        "commitMarker": { "const": "after-jetstream-puback" }
      }
    }
  }
}
