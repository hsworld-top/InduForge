{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://induforge.dev/contracts/runtime/runtime-dlq-event.schema.json",
  "title": "runtime.dlq.event.v1",
  "$comment": "受控失败证据；bodyBase64 解码后最大 1 MiB，禁止放入 Secret、endpoint、DSN 或投递可变元数据。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dlqId", "deploymentId", "accountId", "consumerKey", "originalSubject", "eventId", "reasonCode", "deliveryCount", "bodySha256", "bodyBase64", "occurredAt"],
  "properties": {
    "schemaVersion": { "const": "runtime.dlq.event.v1" },
    "dlqId": { "$ref": "common.schema.json#/$defs/eventId" },
    "deploymentId": { "$ref": "common.schema.json#/$defs/stableId" },
    "accountId": { "$ref": "common.schema.json#/$defs/stableId" },
    "consumerKey": { "$ref": "common.schema.json#/$defs/stableId" },
    "originalSubject": { "type": "string", "minLength": 1, "maxLength": 512 },
    "eventId": { "anyOf": [{ "$ref": "common.schema.json#/$defs/eventId" }, { "type": "null" }] },
    "reasonCode": { "enum": ["permanent-validation", "event-id-collision", "max-deliver", "handler-failure"] },
    "deliveryCount": { "type": "integer", "minimum": 1 },
    "bodySha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "bodyBase64": { "type": "string", "maxLength": 1398104, "pattern": "^([A-Za-z0-9+/]{4})*([A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" },
    "occurredAt": { "$ref": "common.schema.json#/$defs/utcRfc3339" }
  }
}
