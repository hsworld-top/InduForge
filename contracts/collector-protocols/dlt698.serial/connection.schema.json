{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["portName","baudRate","dataBits","parity","stopBits","station","enableCodeFE","useSecurityRequest","clientAddress"],"properties":{"portName":{"type":"string","title":"串口名称（portName）","minLength":1},"baudRate":{"type":"integer","title":"波特率（baudRate）","enum":[1200,2400,4800,9600,19200,38400,57600,115200],"default":9600},"dataBits":{"type":"integer","title":"数据位（dataBits）","enum":[7,8],"default":8},"parity":{"type":"string","title":"校验方式（parity）","enum":["none","odd","even"],"default":"even","x-induforge-enum-labels":{"none":"无校验（none）","odd":"奇校验（odd）","even":"偶校验（even）"}},"stopBits":{"type":"integer","title":"停止位（stopBits）","enum":[1,2],"default":1},"station":{"type":"string","title":"电表地址（station）","pattern":"^[0-9Aa]{1,12}$","default":"1"},"enableCodeFE":{"type":"boolean","title":"启用 FE 前导码（enableCodeFE）","default":false},"useSecurityRequest":{"type":"boolean","title":"使用安全请求（useSecurityRequest）","default":true},"clientAddress":{"type":"integer","title":"客户端地址（clientAddress）","minimum":0,"maximum":255,"default":0},"receiveTimeoutMs":{"type":"integer","title":"接收超时（receiveTimeoutMs）","minimum":100,"maximum":120000,"default":10000,"x-induforge-unit":"ms","x-induforge-advanced":true}}}
