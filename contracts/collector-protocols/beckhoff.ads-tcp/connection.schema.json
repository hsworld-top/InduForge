{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "port"],
  "properties": {
    "host": {
      "type": "string",
      "title": "设备 IP / 主机名（host）",
      "description": "请输入倍福控制器或 TwinCAT 路由服务的 IPv4、IPv6 或主机名",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "title": "ADS TCP 路由端口（port）",
      "description": "TwinCAT ADS 路由服务端口",
      "minimum": 1,
      "maximum": 65535,
      "default": 48898
    },
    "useAutoAmsNetId": {
      "type": "boolean",
      "title": "自动获取目标 AMS Net ID（useAutoAmsNetId）",
      "default": true
    },
    "amsPort": {
      "type": "integer",
      "title": "目标 AMS 端口（amsPort）",
      "description": "TwinCAT 3 PLC Runtime 1 通常为 851，TwinCAT 2 常见为 801",
      "minimum": 1,
      "maximum": 65535,
      "default": 851
    },
    "targetAmsNetId": {
      "type": "string",
      "title": "目标 AMS Net ID（targetAmsNetId）",
      "description": "手动模式必填，例如 192.168.1.10.1.1；AMS 端口请单独配置",
      "pattern": "^(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){5}$",
      "x-induforge-advanced": true
    },
    "senderAmsNetId": {
      "type": "string",
      "title": "本机 AMS Net ID（senderAmsNetId）",
      "description": "仅在路由环境要求固定发送端标识时配置，例如 192.168.1.20.1.1",
      "pattern": "^(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})(?:\\.(?:25[0-5]|2[0-4][0-9]|1?[0-9]{1,2})){5}$",
      "x-induforge-advanced": true
    },
    "useTagCache": {
      "type": "boolean",
      "title": "启用符号标签缓存（useTagCache）",
      "description": "缓存符号句柄以提升重复读取速度",
      "default": true,
      "x-induforge-advanced": true
    },
    "connectTimeoutMs": {
      "type": "integer",
      "title": "连接超时（connectTimeoutMs）",
      "minimum": 100,
      "maximum": 120000,
      "default": 5000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    },
    "receiveTimeoutMs": {
      "type": "integer",
      "title": "接收超时（receiveTimeoutMs）",
      "minimum": 100,
      "maximum": 120000,
      "default": 5000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    },
    "dataFormat": {
      "type": "string",
      "title": "数据格式（dataFormat）",
      "enum": ["ABCD", "BADC", "CDAB", "DCBA"],
      "default": "DCBA",
      "x-induforge-advanced": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "useAutoAmsNetId": { "const": false } },
        "required": ["useAutoAmsNetId"]
      },
      "then": { "required": ["targetAmsNetId"] }
    }
  ]
}
