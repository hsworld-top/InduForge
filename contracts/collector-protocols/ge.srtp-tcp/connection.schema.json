{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "port"],
  "properties": {
    "host": {
      "type": "string",
      "title": "设备 IP / 主机名（host）",
      "description": "请输入 GE PLC 的 IPv4、IPv6 或主机名",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "title": "端口（port）",
      "description": "GE SRTP 以太网通信端口",
      "minimum": 1,
      "maximum": 65535,
      "default": 18245
    },
    "connectTimeoutMs": {
      "type": "integer",
      "title": "连接超时（connectTimeoutMs）",
      "minimum": 100,
      "maximum": 120000,
      "default": 5000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    },
    "receiveTimeoutMs": {
      "type": "integer",
      "title": "接收超时（receiveTimeoutMs）",
      "minimum": 100,
      "maximum": 120000,
      "default": 10000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    },
    "dataFormat": {
      "type": "string",
      "title": "数据格式（dataFormat）",
      "enum": ["ABCD", "BADC", "CDAB", "DCBA"],
      "default": "DCBA",
      "x-induforge-advanced": true
    }
  }
}
