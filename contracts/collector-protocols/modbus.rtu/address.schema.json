{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["station", "area", "address"],
  "properties": {
    "station": { "type": "integer", "title": "从站地址", "minimum": 1, "maximum": 247 },
    "area": {
      "type": "string",
      "title": "存储区",
      "enum": ["coil", "discreteInput", "inputRegister", "holdingRegister"]
    },
    "address": {
      "type": "integer",
      "title": "起始地址",
      "minimum": 0,
      "maximum": 65535,
      "x-induforge-address-text": true
    },
    "bitIndex": { "type": "integer", "title": "位索引", "minimum": 0, "maximum": 15 }
  }
}
