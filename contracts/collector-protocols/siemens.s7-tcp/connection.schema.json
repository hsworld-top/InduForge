{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["host", "port", "plcType", "rack", "slot"],
  "properties": {
    "host": {
      "type": "string",
      "title": "设备 IP / 主机名（host）",
      "description": "请输入 Siemens PLC 的 IPv4、IPv6 或主机名",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "title": "端口（port）",
      "description": "Siemens S7 TCP 服务端口",
      "minimum": 1,
      "maximum": 65535,
      "default": 102
    },
    "plcType": {
      "type": "string",
      "title": "PLC 型号（plcType）",
      "description": "选择目标 Siemens PLC 系列，用于匹配 S7 握手参数",
      "enum": ["S1200", "S1500", "S300", "S400", "S200Smart", "S200"],
      "default": "S1200",
      "x-induforge-enum-labels": {
        "S1200": "S7-1200",
        "S1500": "S7-1500",
        "S300": "S7-300",
        "S400": "S7-400",
        "S200Smart": "S7-200 SMART",
        "S200": "S7-200"
      }
    },
    "rack": {
      "type": "integer",
      "title": "机架号（rack）",
      "description": "PLC CPU 所在机架编号",
      "minimum": 0,
      "maximum": 7,
      "default": 0
    },
    "slot": {
      "type": "integer",
      "title": "槽位号（slot）",
      "description": "PLC CPU 所在槽位编号",
      "minimum": 0,
      "maximum": 31,
      "default": 1
    },
    "localTsap": {
      "type": "integer",
      "title": "本地 TSAP（localTsap）",
      "description": "可选的本地传输服务访问点",
      "minimum": 0,
      "maximum": 65535,
      "x-induforge-advanced": true
    },
    "remoteTsap": {
      "type": "integer",
      "title": "远端 TSAP（remoteTsap）",
      "description": "可选的 PLC 传输服务访问点",
      "minimum": 0,
      "maximum": 65535,
      "x-induforge-advanced": true
    },
    "connectTimeoutMs": {
      "type": "integer",
      "title": "连接超时（connectTimeoutMs）",
      "description": "建立 S7 TCP 连接的最大等待时间",
      "minimum": 100,
      "maximum": 120000,
      "default": 5000,
      "x-induforge-unit": "ms",
      "x-induforge-advanced": true
    }
  }
}
