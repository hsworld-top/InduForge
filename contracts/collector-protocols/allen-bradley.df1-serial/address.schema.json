{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object","additionalProperties":false,"required":["address"],"properties":{"address":{"type":"string","title":"PLC 文件地址（address）","description":"例如 N9:0、S:0/1、s=2;N9:0 或 s=2;dst=1;src=2;N9:0","pattern":"^(?:(?:s|dst|src)=\\d+;)*(?:ST|A|B|N|F|S|C|I|O|R|T|L)\\d*:\\d+(?:(?:/|\\.)\\d+)?$","maxLength":512,"x-induforge-address-text":true}}}
