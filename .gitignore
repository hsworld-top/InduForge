*.pfx                  # PFX 证书

# 备份文件
*.bak                  # 备份文件
*.backup               # 备份文件
*.old                  # 旧版本文件
*.orig                 # 原始文件
*.tmp                  # 临时文件

# 编辑器和IDE文件
.vscode/               # VSCode 配置目录（取消注释启用）
.idea/                 # IntelliJ IDEA 配置目录
*.sublime-project      # Sublime Text 项目文件
*.sublime-workspace    # Sublime Text 工作区文件
.project               # Eclipse 项目文件
.classpath             # Eclipse 类路径文件
.settings/             # Eclipse 设置目录
*.tmproj               # TextMate 项目文件
*.tmproject            # TextMate 项目文件

