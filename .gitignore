# 依赖相关文件
node_modules/          # Node.js 依赖包目录
datacenter/node_modules/
designer/node_modules/
dev_ide/node_modules/
dev_core/node_modules/
npm-debug.log*         # npm 调试日志文件
yarn-debug.log*        # Yarn 调试日志文件
yarn-error.log*        # Yarn 错误日志文件
pnpm-debug.log*        # pnpm 调试日志文件
lerna-debug.log*       # Lerna 调试日志文件（多包管理工具）

# 运行时数据
pids                   # 进程ID文件目录
*.pid                  # 进程ID文件
*.seed                 # 随机种子文件
*.pid.lock             # 进程ID锁文件（防止进程重复启动）

# 测试覆盖率目录（如 istanbul 工具生成）
coverage/              # 覆盖率报告目录
*.lcov                 # LCOV 格式覆盖率文件

# nyc 测试覆盖率（Istanbul 新版工具）
.nyc_output            # nyc 覆盖率原始数据目录

# Grunt 临时文件（Grunt 插件任务文件存储）
.grunt                 # Grunt 中间缓存目录

# Bower 依赖目录（Bower 包管理工具）
bower_components       # Bower 依赖包目录（已逐步淘汰）

# node-waf 配置文件
.lock-wscript          # node-waf 构建锁文件

# 编译后的二进制扩展（Node.js C++ 扩展）
build/Release          # 编译生成的二进制文件目录

# JSPM 依赖目录（JSPM 模块加载器）
jspm_packages/         # JSPM 依赖包目录

# TypeScript 缓存
*.tsbuildinfo          # TypeScript 构建缓存文件（加速增量构建）

# 可选的 npm 缓存目录
.npm                   # npm 本地缓存目录

# 可选的 eslint 缓存
.eslintcache           # ESLint 校验缓存文件（加速重复校验）

# 可选的 stylelint 缓存
.stylelintcache        # Stylelint 样式校验缓存文件

# Microbundle 缓存（微前端/模块打包工具）
.rpt2_cache/           # Microbundle 缓存目录
.rts2_cache_cjs/       # CommonJS 格式缓存
.rts2_cache_es/        # ES 模块格式缓存
.rts2_cache_umd/       # UMD 格式缓存

# 可选的 Node REPL 历史记录
.node_repl_history     # Node 交互式终端历史记录文件

# npm pack 打包输出文件
*.tgz                  # npm pack 生成的压缩包

# Yarn 完整性校验文件
.yarn-integrity        # Yarn 依赖完整性校验文件

# dotenv 环境变量文件
.env                   # 基础环境变量文件
.env.development.local # 开发环境本地环境变量（不提交）
.env.test.local        # 测试环境本地环境变量（不提交）
.env.production.local  # 生产环境本地环境变量（不提交）
.env.local             # 本地环境变量（优先级最高，不提交）

# Parcel 打包工具缓存
.cache                 # Parcel 缓存目录
.parcel-cache          # Parcel 新版缓存目录

# Next.js 构建输出
.next                  # Next.js 构建缓存目录
out                    # Next.js 静态导出目录

# Nuxt.js 构建/生成输出
.nuxt                  # Nuxt.js 构建目录
dist                   # Nuxt.js 打包输出目录

# Gatsby 相关文件
.cache/                # Gatsby 构建缓存
public                 # Gatsby 静态生成目录

# VuePress 构建输出
.vuepress/dist         # VuePress 静态站点输出目录

# Vite 构建输出
dist/                  # Vite 生产构建目录
dist-ssr/              # Vite SSR 构建目录

# Serverless 框架目录
.serverless/           # Serverless 部署打包目录

# FuseBox 缓存（模块化打包工具）
.fusebox/              # FuseBox 缓存目录

# DynamoDB Local 本地数据库文件
.dynamodb/             # DynamoDB 本地实例数据目录

# TernJS 端口文件（JavaScript 智能提示工具）
.tern-port             # TernJS 服务端口文件

# VSCode 扩展测试版本文件
.vscode-test           # VSCode 扩展测试时的版本缓存

# Yarn v2 相关文件
.yarn/cache            # Yarn v2 缓存目录
.yarn/unplugged        # Yarn v2 未打包依赖目录
.yarn/build-state.yml  # Yarn v2 构建状态文件
.yarn/install-state.gz # Yarn v2 安装状态文件
.pnp.*                 # Yarn v2 Plug'n'Play 依赖解析文件

# 数据库文件
*.db                   # 通用数据库文件
*.sqlite               # SQLite 数据库文件
*.sqlite3              # SQLite3 数据库文件

# 日志文件
logs                   # 日志目录
*.log                  # 所有日志文件

# 操作系统自动生成的文件
.DS_Store              # macOS 文件夹属性文件
.DS_Store?             # macOS 隐藏属性文件（通配）
._*                    # macOS 隐藏文件
.Spotlight-V100        # macOS 索引文件
.Trashes               # macOS 废纸篓文件
ehthumbs.db            # Windows 缩略图数据库
Thumbs.db              # Windows 缩略图缓存文件

# IDE 相关文件
.vscode/               # VSCode 配置目录
.idea/                 # IntelliJ IDEA 配置目录
*.swp                  # Vim 交换文件
*.swo                  # Vim 交换文件（旧版）
*~                     # Vim 临时文件

# 临时文件目录
tmp/                   # 临时目录
temp/                  # 临时目录（别名）
.tmp/                  # 隐藏临时目录

# 构建产物
build/                 # 通用构建目录
dist/                  # 通用打包输出目录
out/                   # 通用输出目录

# 锁文件（如需忽略请取消注释）
# package-lock.json    # npm 依赖锁文件
# yarn.lock            # Yarn 依赖锁文件
# pnpm-lock.yaml       # pnpm 依赖锁文件

# Docker 相关
.dockerignore          # Docker 忽略文件
docker-compose.override.yml # Docker Compose 本地覆盖配置

# Nginx 日志
nginx/logs/            # Nginx 日志目录
nginx/access.log       # Nginx 访问日志
nginx/error.log        # Nginx 错误日志

# 应用业务相关
uploads/               # 上传文件目录
storage/               # 应用存储目录
public/uploads/        # 公共目录下的上传文件

# 敏感配置文件
.env                   # 环境变量文件（应提交 .env.example 模板）
config/config.json     # 敏感配置文件（dev_core）
dev_core/config/config.json  # 后端配置文件

